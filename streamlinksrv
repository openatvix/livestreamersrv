def Stream(streamlink, http, url, argstr, quality):
    global PARSER, _loglevel, PLUGIN_ARGS
    fd = None
    not_stream_opened = True
    plugin = None
    pluginname = ""
    stream_name = None
    requested_streams = []
    try:
        args = None
        if PARSER:
            if not PLUGIN_ARGS:
                PLUGIN_ARGS = setup_plugin_args(streamlink)
            config_files, plugin, pluginname = setup_config_files(streamlink, url)
            if config_files or argstr:
                arglist = argsplit(argstr[0]) if argstr and argstr[0] else []
                try:
                    args = setup_args(arglist, config_files=config_files, ignore_unknown=False)
                    class SafeNamespace(argparse.Namespace):
                        def __getattr__(self, name):
                            return None
                    args = SafeNamespace(**vars(args))
                except Exception as e:
                    LOGGER.error("Argument parsing error: %s", str(e))
                    return sendOfflineMP4(http, send_headers=not_stream_opened)
                else:
                    set_loglevel(args.loglevel)
                    setupHttpSession(streamlink, args)
                    setupTransportOpts(streamlink, args)
                    optimize_stream(streamlink, args)
        if not plugin:
            cache = PLUGIN_CACHE.get(url)

            if cache:
                pluginname, pluginclass, resolved_url = cache
            else:
                pluginname, pluginclass, resolved_url = \
                    streamlink.resolve_url(url)

                if len(PLUGIN_CACHE) >= 512:
                    PLUGIN_CACHE.popitem(last=False)

                PLUGIN_CACHE[url] = (
                    pluginname,
                    pluginclass,
                    resolved_url
                )
            plugin = pluginclass(streamlink, resolved_url)
        if PARSER and PLUGIN_ARGS and args:
            setup_plugin_options(streamlink, plugin, args, pluginname)
            log_current_arguments(streamlink, args, url, quality)
        LOGGER.info("Found plugin %s for URL %s", pluginname, url)
        if args:
            streams = plugin.streams(stream_types=args.stream_types, sorting_excludes=args.stream_sorting_excludes)
        else:
            streams = plugin.streams()
        if not streams:
            LOGGER.error("No playable streams found for URL: %s", url)
            return sendOfflineMP4(http, send_headers=not_stream_opened)
        LOGGER.info("Available streams: %s", format_valid_streams(plugin, streams))
        stream = None
        requested_streams = [resolve_stream_name(streams, s.strip()) for s in quality.split(',')]
        for stream_name_candidate in requested_streams:
            if stream_name_candidate in streams:
                stream = True
                stream_name = stream_name_candidate
                break
        if not stream:
            if "best" in streams:
                stream_name = "best"
                LOGGER.info("Stream '%s' not found, using 'best'", quality)
            else:
                LOGGER.error("Stream '%s' not found", quality)
                return sendOfflineMP4(http, send_headers=not_stream_opened)
        if stream_name and not stream_name.endswith("_alt") and stream_name not in STREAM_SYNONYMS:
            prefix = stream_name
            alt_streams = [k for k in sorted(streams.keys()) if k.startswith(prefix) and "_alt" in k]
        else:
            alt_streams = []
        if args and args.http_add_audio:
            http_add_audio = HTTPStream(streamlink, args.http_add_audio)
        else:
            http_add_audio = False
        prebuffer = None
        stream_names = [stream_name] + alt_streams if stream_name else []
        dyn_cfg = BUFFER_CONFIG.copy()
        for current_stream_name in stream_names:
            stream = streams[current_stream_name]
            stream_type = type(stream).shortname()
            bitrate = getattr(stream, "bitrate", None)
            dyn_cfg = get_dynamic_buffer_config(stream_type, bitrate)

            apply_universal_stream_optimizations(stream, streamlink)

            if is_fhd_stream(bitrate, stream_type):
                LOGGER.info("FHD stream detected: %s (bitrate: %s)", current_stream_name, bitrate)

            if http_add_audio and stream_type in ("hls", "http", "rtmp"):
                stream = MuxedStream(streamlink, stream, http_add_audio, add_audio=True,
                                    copyts=args.ffmpeg_copyts if args else True,
                                    start_at_zero=args.ffmpeg_start_at_zero if args else False)
                stream_type = "muxed-stream"
            player_passthrough = stream_type == "hls" and hasattr(plugin, 'module') and plugin.module == "youtube"
            if args and ((stream_type in args.player_passthrough or player_passthrough) or
                        (hasattr(args, 'stream_passthrough_encrypted') and args.stream_passthrough_encrypted)):
                stream_url = stream_to_url(stream)
                LOGGER.debug("301 Passthrough - URL: %s", stream_url)
                try:
                    http.send_response(301)
                    http.send_header("Location", stream_url)
                    http.send_header("Content-Length", "0")
                    http.send_header("Connection", "close")
                    http.end_headers()
                except (BrokenPipeError, socket.error):
                    LOGGER.info("Client disconnected during redirect")
                return
            fd, prebuffer = test_stream(plugin, args, stream)
            if prebuffer:
                break
        if not prebuffer:
            retry_count = args.retry_open if args and hasattr(args, 'retry_open') else BUFFER_CONFIG["MAX_RETRIES"]
            raise StreamError("Could not open stream after %d attempts" % retry_count)
        LOGGER.debug("Writing stream to player")
        not_stream_opened = False
        sendHeaders(http)
        try:
            http.wfile.write(prebuffer)
        except (BrokenPipeError, socket.error):
            LOGGER.info("Client disconnected during prebuffer")
            return
        flush_counter = 0
        chunk_size = dyn_cfg["STREAM_CHUNK_SIZE"]
        stream_timeout = dyn_cfg.get("STREAM_READ_TIMEOUT", 60)
        LOGGER.debug("Chunk size: %d bytes, timeout: %d seconds", chunk_size, stream_timeout)
        sock = getattr(fd, "socket", None)
        if sock:
            try:
                sock.settimeout(stream_timeout)
            except Exception as e:
                LOGGER.debug("Socket timeout not set: %s", str(e))
        consecutive_timeouts = 0
        last_activity = time.time()
        flush_threshold = max(16, 2097152 // chunk_size)
        while True:
            try:
                data = fd.read(chunk_size)
                if data:
                    consecutive_timeouts = 0
                    last_activity = time.time()
                else:
                    break
            except socket.timeout:
                consecutive_timeouts += 1
                LOGGER.warning("Stream timeout (%d/8)", consecutive_timeouts)
                if consecutive_timeouts >= 8:
                    LOGGER.error("Stream frozen, aborting")
                    break
                continue
            except (IOError, OSError) as e:
                if "timeout" in str(e).lower():
                    consecutive_timeouts += 1
                    if consecutive_timeouts >= 8:
                        break
                    continue
                LOGGER.warning("Read error: %s", str(e))
                break
            except Exception as e:
                LOGGER.warning("Read error: %s", str(e))
                break
            if time.time() - last_activity > 90:
                LOGGER.warning("No data received for 90 seconds, aborting")
                break
            try:
                http.wfile.write(data)
                flush_counter += 1
                if flush_counter >= flush_threshold:
                    try:
                        http.wfile.flush()
                    except (BrokenPipeError, socket.error, OSError):
                        LOGGER.info("Player disconnected")
                        break
                    flush_counter = 0
            except (BrokenPipeError, socket.error, OSError):
                LOGGER.info("Player disconnected")
                break
    except NoPluginError:
        LOGGER.error("No plugin for URL: %s", url)
        sendOfflineMP4(http, send_headers=not_stream_opened)
    except (PluginError, FatalPluginError, StreamError, NoStreamsError) as err:
        error_str = str(err).lower()
        if "validationerror" not in error_str and "xml_find" not in error_str:
            LOGGER.error(str(err))
        else:
            LOGGER.debug("Stream unavailable: %s", str(err)[:100])
        sendOfflineMP4(http, send_headers=not_stream_opened)
    except socket.error as err:
        if err.errno != errno.EPIPE:
            LOGGER.error("Socket error: %s", str(err))
        else:
            LOGGER.info("Player disconnected")
    except Exception as err:
        if not_stream_opened and LOGLEVEL not in ("debug", "trace"):
            LOGGER.error("Exception: %s", str(err))
        else:
            LOGGER.error("Exception: %s\n%s", str(err), traceback.format_exc())
        sendOfflineMP4(http, send_headers=not_stream_opened)
    except KeyboardInterrupt:
        pass
    finally:
        if fd is not None:
            try:
                fd.close()
            except Exception:
                pass
        if plugin and hasattr(plugin, 'close'):
            try:
                plugin.close()
            except Exception:
                pass
        if hasattr(streamlink, 'plugins'):
            streamlink.plugins.clear()
        stream = None
        streams = None
        plugin = None
        try:
            if len(gc.get_objects()) > 100000:
                gc.collect()
        except Exception:
            pass


class StreamHandler(BaseHTTPRequestHandler):
    timeout = 60

    def validate_url(self, url):
        if not url:
            return False
        if any(c in url for c in ['..', '\\', '\x00', '\r', '\n']):
            LOGGER.warning("Blocked suspicious URL: %s", url)
            return False
        if url.startswith('file://') or url.startswith('//'):
            LOGGER.warning("Blocked file:// or // URI: %s", url)
            return False
        parsed = urlparse(url)
        if parsed.scheme and parsed.scheme not in ['http', 'https']:
            LOGGER.warning("Blocked non-http URL: %s", url)
            return False
        return True

    def do_HEAD(s):
        sendHeaders(s)

    def do_GET(s):
        try:
            s.connection.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
            s.connection.setsockopt(socket.SOL_SOCKET, socket.SO_SNDBUF, BUFFER_CONFIG["SOCKET_SNDBUF"])
            s.connection.setsockopt(socket.SOL_SOCKET, socket.SO_RCVBUF, BUFFER_CONFIG["SOCKET_RCVBUF"])
            s.connection.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
        except Exception as e:
            LOGGER.debug("Socket tuning skipped: %s", str(e))
        try:
            s.connection.settimeout(60)
        except Exception:
            pass
        path = unquote(s.path[1:])
        if re.match(r'^[0-9]+:', path):
            path = parse_service_reference(path)
        if not s.validate_url(path.split(' -', 1)[0].strip()):
            s.send_response(400)
            s.end_headers()
            return
        quality = "best"
        if path.startswith("q=") and "/" in path:
            i = path.index("/")
            quality = path[2:i].replace(" ", "")
            path = path[i + 1:]
        url_parts = path.split(' -', 1)
        url = url_parts[0].strip()
        argstr = url_parts[1:2] if len(url_parts) > 1 else []
        LOGGER.debug("Processing: %s [%s]", url, quality)
        with warnings.catch_warnings():
            warnings.simplefilter("ignore")
            streamlink = create_fresh_streamlink_session()
        return Stream(streamlink, s, url, argstr, quality)

    def finish(self, *args, **kw):
        try:
            if hasattr(self, 'wfile') and self.wfile and not getattr(self.wfile, 'closed', True):
                try:
                    self.wfile.flush()
                except Exception:
                    pass
                try:
                    self.wfile.close()
                except Exception:
                    pass
        except Exception:
            pass
        finally:
            try:
                if hasattr(self, 'rfile') and self.rfile:
                    self.rfile.close()
            except Exception:
                pass
            try:
                super().finish()
            except Exception:
                pass

    def handle(self):
        try:
            if hasattr(self, 'connection'):
                try:
                    self.connection.settimeout(self.timeout)
                except Exception:
                    pass
            BaseHTTPRequestHandler.handle(self)
        except socket.timeout:
            LOGGER.debug("Connection timeout")
        except (socket.error, OSError) as e:
            if not (hasattr(e, 'errno') and e.errno in (errno.EPIPE, errno.ECONNRESET, errno.EBADF)):
                LOGGER.debug("Socket error: %s", str(e))
        except Exception as e:
            LOGGER.debug("Handler error: %s", str(e))

    def log_message(self, format, *args):
        if LOGLEVEL in ("trace", "debug"):
            LOGGER.debug(format % args)


class ThreadedHTTPServer(ThreadingMixIn, HTTPServer):
    daemon_threads = True
    allow_reuse_address = True
    request_queue_size = 128
    timeout = 60

    def shutdown_request(self, request):
        try:
            request.shutdown(socket.SHUT_WR)
        except OSError:
            pass
        try:
            request.close()
        except OSError:
            pass


def start():
    def setup_logging(stream=sys.stdout, level="info"):
        fmt = ("[{asctime},{msecs:0.0f}]" if level == "trace" else "") + "[{name}][{levelname}] {message}"
        logger.basicConfig(stream=stream, level=level, format=fmt, style="{", datefmt="%H:%M:%S")

    def apply_global_loglevel():
        logger.root.setLevel(LOGLEVEL)
        LOGGER.setLevel(LOGLEVEL)

    global LOGGER, PARSER, GLOBAL_STREAMLINK
    setup_logging(level=LOGLEVEL)
    apply_global_loglevel()
    LOGGER.info("DM920 Streamlink Server v%s - Ultimate Optimizations", __version__)
    LOGGER.info("CPU: 2 cores, NEON enabled, %dMB RAM", get_total_memory_mb())
    LOGGER.info("Settings: prebuffer=%dKB, chunks=%dKB, threads=%d, live-edge=%d",
                BUFFER_CONFIG["DEFAULT_PREBUFFER"]//1024,
                BUFFER_CONFIG["STREAM_CHUNK_SIZE"]//1024,
                BUFFER_CONFIG["HLS_SEGMENT_THREADS"],
                BUFFER_CONFIG["HLS_LIVE_EDGE"])
    LOGGER.info("User-Agent: %s", DEFAULT_USER_AGENT)
    PARSER = build_parser()
    GLOBAL_STREAMLINK = create_fresh_streamlink_session()
    httpd = ThreadedHTTPServer(("", PORT_NUMBER), StreamHandler)
    versions = get_system_versions()
    LOGGER.info("Streamlink v%s, GStreamer %s, FFmpeg %s",
                streamlink_version, versions['gstreamer'], versions['ffmpeg'])
    original_sigtstp = signal.signal(signal.SIGTSTP, signal.SIG_DFL)
    original_sigquit = signal.signal(signal.SIGQUIT, signal.SIG_DFL)
    signal.signal(signal.SIGPIPE, signal.SIG_IGN)
    signal.signal(signal.SIGTERM, signal.default_int_handler)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        LOGGER.info("Shutting down...")
    finally:
        httpd.server_close()
        signal.signal(signal.SIGTSTP, original_sigtstp)
        signal.signal(signal.SIGQUIT, original_sigquit)
        LOGGER.info("Server stopped")


class Daemon:
    def __init__(self, pidfile, stdin="/dev/null", stdout="/dev/null", stderr="/dev/null"):
        self.stdin = stdin
        self.stdout = stdout
        self.stderr = stderr
        self.pidfile = pidfile

    def daemonize(self):
        try:
            pid = os.fork()
            if pid > 0:
                sys.exit(0)
        except OSError as e:
            sys.stderr.write("fork #1 failed: %d (%s)\n" % (e.errno, e.strerror))
            sys.exit(1)
        os.chdir("/")
        os.setsid()
        os.umask(0)
        try:
            pid = os.fork()
            if pid > 0:
                sys.exit(0)
        except OSError as e:
            sys.stderr.write("fork #2 failed: %d (%s)\n" % (e.errno, e.strerror))
            sys.exit(1)
        sys.stdout.flush()
        sys.stderr.flush()
        si = open(self.stdin, "r")
        so = open(self.stdout, "a+")
        se = open(self.stderr, "a+")
        os.dup2(si.fileno(), sys.stdin.fileno())
        os.dup2(so.fileno(), sys.stdout.fileno())
        os.dup2(se.fileno(), sys.stderr.fileno())
        atexit.register(self.delpid)
        pid = str(os.getpid())
        open(self.pidfile, "w+").write("%s\n" % pid)

    def delpid(self):
        try:
            os.remove(self.pidfile)
        except OSError:
            pass

    def start(self):
        try:
            with open(self.pidfile, "r") as pf:
                pid = int(pf.read().strip())
            if pid:
                sys.stderr.write("Daemon already running\n")
                sys.exit(1)
        except (IOError, ValueError):
            pass
        self.daemonize()
        self.run()

    def stop(self):
        try:
            with open(self.pidfile, "r") as pf:
                pid = int(pf.read().strip())
        except (IOError, ValueError):
            sys.stderr.write("Not running\n")
            return
        try:
            os.kill(pid, signal.SIGTERM)
            time.sleep(0.5)
            try:
                os.kill(pid, 0)
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass
        except OSError as err:
            if "No such process" in str(err):
                if os.path.exists(self.pidfile):
                    os.remove(self.pidfile)
            else:
                print(str(err))
                sys.exit(1)

    def restart(self):
        self.stop()
        self.start()

    def run(self):
        start()


class StreamlinkDaemon(Daemon):
    def run(self):
        start()


if __name__ == "__main__":
    daemon = StreamlinkDaemon("/var/run/streamlink.pid")
    if len(sys.argv) >= 2:
        if "start" == sys.argv[1]:
            daemon.start()
        elif "stop" == sys.argv[1]:
            daemon.stop()
        elif "restart" == sys.argv[1]:
            daemon.restart()
        elif "manualstart" == sys.argv[1]:
            daemon.stop()
            if len(sys.argv) > 2 and sys.argv[2] in ("debug", "trace"):
                set_loglevel(sys.argv[2])
            start()
        else:
            print("Unknown command")
            sys.exit(2)
        sys.exit(0)
    else:
        print("usage: %s start|stop|restart|manualstart" % sys.argv[0])
        print("          manualstart include a stop")
        sys.exit(2)
