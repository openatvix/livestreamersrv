    streamlink.set_option("hls-playlist-reload-time", BUFFER_CONFIG["HLS_PLAYLIST_RELOAD_TIME"])
    streamlink.set_option("hls-segment-stream-data", True)

    if total_mem_mb < 512:
        streamlink.set_option("ringbuffer-size", 1024 * 1024)
    else:
        streamlink.set_option("ringbuffer-size", BUFFER_CONFIG["CACHE_SIZE"])

    os.environ["STREAMLINK_NEON_OPT"] = "2"
    os.environ["FFMPEG_NEON_OPT"] = "2"

    streamlink.set_option("stream-timeout", BUFFER_CONFIG["STREAM_TIMEOUT"])
    streamlink.set_option("hls-timeout", BUFFER_CONFIG["HLS_TIMEOUT"])
    streamlink.set_option("http-timeout", BUFFER_CONFIG["HTTP_TIMEOUT"])

    try:
        streamlink.http.mount(
            "http://",
            HTTPAdapter(
                pool_connections=BUFFER_CONFIG["HTTP_POOL_CONNECTIONS"],
                pool_maxsize=BUFFER_CONFIG["HTTP_POOL_MAXSIZE"],
                max_retries=0
            )
        )
        streamlink.http.mount(
            "https://",
            HTTPAdapter(
                pool_connections=BUFFER_CONFIG["HTTP_POOL_CONNECTIONS"],
                pool_maxsize=BUFFER_CONFIG["HTTP_POOL_MAXSIZE"],
                max_retries=0
            )
        )
    except Exception:
        pass

    LOGGER.debug("DM920 optimizations: threads=%d, NEON=enabled, timeouts=%d/%d/%d",
                 BUFFER_CONFIG["HLS_SEGMENT_THREADS"], BUFFER_CONFIG["STREAM_TIMEOUT"],
                 BUFFER_CONFIG["HLS_TIMEOUT"], BUFFER_CONFIG["HTTP_TIMEOUT"])


def test_stream(plugin, args, stream):
    prebuffer = None
    retry_open = args.retry_open if hasattr(args, 'retry_open') else BUFFER_CONFIG["MAX_RETRIES"]

    apply_universal_stream_optimizations(stream)

    for i in range(retry_open):
        stream_fd = None
        try:
            stream_fd = stream.open()
            try:
                stream_type = type(stream).shortname()
            except Exception:
                stream_type = None

            bitrate = getattr(stream, "bitrate", None)
            is_fhd = is_fhd_stream(bitrate, stream_type)

            # Ultimate prebuffer settings
            if is_fhd:
                prebuffer_size = 65536
            else:
                prebuffer_size = BUFFER_CONFIG["DEFAULT_PREBUFFER"]
                if stream_type in ("hls", "dash"):
                    prebuffer_size = 32768
                elif stream_type in ("http", "rtmp"):
                    prebuffer_size = 65536

            if bitrate and bitrate > 8000000:
                prebuffer_size = int(prebuffer_size * 1.5)

            prebuffer_size = max(16384, min(prebuffer_size, 131072))
            LOGGER.debug("Pre-buffering %d bytes (%s, FHD=%s)", prebuffer_size, stream_type, is_fhd)
            prebuffer = stream_fd.read(prebuffer_size)
            if prebuffer:
                return stream_fd, prebuffer
        except StreamError as err:
            LOGGER.error("Try %d/%d: Could not open stream %s (%s)", i + 1, retry_open, stream, err)
        except IOError as err:
            LOGGER.error("Failed to read data from stream: %s", err)
        finally:
            if stream_fd and not prebuffer:
                stream_fd.close()
        if i < retry_open - 1:
            time.sleep(BUFFER_CONFIG["RETRY_DELAY"])
    LOGGER.error("No data returned from stream")
    return None, None


def log_current_arguments(streamlink, args, url, quality):
    global PARSER, LOGGER
    if not logger.root.isEnabledFor(logging.DEBUG):
        return
    sensitive = set()
    for pname, plugin in streamlink.plugins.get_loaded().items():
        for parg in plugin.arguments or []:
            if parg.sensitive:
                sensitive.add(parg.argument_name(pname))
    LOGGER.debug("Arguments:")
    LOGGER.debug(" url=%s", url)
    LOGGER.debug(" stream=%s", quality.split(","))
    for action in PARSER._actions:
        if not hasattr(args, action.dest):
            continue
        value = getattr(args, action.dest)
        if action.default != value:
            name = next((option for option in action.option_strings if option.startswith("--")), action.option_strings[0]) if action.option_strings else action.dest
            LOGGER.debug(" %s=%s", name, value if name not in sensitive else '*' * 8)


def sendHeaders(http, status=200, type="video/mp4", content_length=None):
    http.send_response(status)
    http.send_header("Server", "Streamlink/{}".format(__version__))
    http.send_header("Content-type", type)
    if content_length is not None:
        http.send_header("Content-Length", str(content_length))
    http.send_header("Connection", "close")
    http.send_header("Cache-Control", "no-cache")
    http.send_header("Keep-Alive", "timeout=5, max=100")
    http.end_headers()


def sendOfflineMP4(http, send_headers=True):
    LOGGER.debug("Send Offline clip")
    try:
        if send_headers:
            sendHeaders(http, type="video/mp4")
        offline_path = "/usr/share/offline.mp4"
