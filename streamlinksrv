def is_fhd_stream(bitrate=None, stream_type=None, resolution=None):
    """Detect if stream is FHD (1080p) or higher"""
    if bitrate and bitrate > BUFFER_CONFIG["FHD_BITRATE_THRESHOLD"]:
        return True
    if stream_type in ("hls", "dash") and bitrate and bitrate > 4000000:
        return True
    return False


def get_dynamic_buffer_config(stream_type=None, bitrate=None):
    cfg = BUFFER_CONFIG.copy()
    is_fhd = is_fhd_stream(bitrate, stream_type)

    if is_fhd:
        cfg["STREAM_CHUNK_SIZE"] = 768 * 1024
        cfg["WRITE_BUFFER_SIZE"] = 512 * 1024
        cfg["DEFAULT_PREBUFFER"] = 65536
        cfg["STREAM_READ_TIMEOUT"] = 90
        LOGGER.debug("FHD stream detected, using optimized buffers")
    elif stream_type in ("hls", "dash"):
        cfg["STREAM_CHUNK_SIZE"] = 256 * 1024
        cfg["WRITE_BUFFER_SIZE"] = 128 * 1024
        cfg["DEFAULT_PREBUFFER"] = 32768
    elif stream_type in ("http", "rtmp"):
        cfg["STREAM_CHUNK_SIZE"] = 512 * 1024
        cfg["WRITE_BUFFER_SIZE"] = 256 * 1024
        cfg["DEFAULT_PREBUFFER"] = 32768

    if bitrate and bitrate > 8000000:
        cfg["STREAM_CHUNK_SIZE"] = int(cfg["STREAM_CHUNK_SIZE"] * 1.5)
        cfg["WRITE_BUFFER_SIZE"] = int(cfg["WRITE_BUFFER_SIZE"] * 1.5)
        cfg["DEFAULT_PREBUFFER"] = int(cfg["DEFAULT_PREBUFFER"] * 1.5)

    return cfg


def apply_universal_stream_optimizations(stream, session=None):
    """Apply universal optimizations to any stream object"""
    if not session:
        session = stream.session if hasattr(stream, 'session') else None
    if not session:
        return

    # Set Chrome User Agent on session
    try:
        if hasattr(session, 'http') and hasattr(session.http, 'headers'):
            session.http.headers.update({'User-Agent': DEFAULT_USER_AGENT})
    except Exception:
        pass

    if isinstance(stream, HLSStream):
        session.set_option("hls-live-edge", BUFFER_CONFIG["HLS_LIVE_EDGE"])
        session.set_option("hls-segment-threads", BUFFER_CONFIG["HLS_SEGMENT_THREADS"])
        session.set_option("hls-segment-attempts", BUFFER_CONFIG["HLS_SEGMENT_ATTEMPTS"])
        session.set_option("hls-segment-timeout", BUFFER_CONFIG["HLS_SEGMENT_TIMEOUT"])
        session.set_option("hls-playlist-reload-attempts", BUFFER_CONFIG["HLS_PLAYLIST_RELOAD_ATTEMPTS"])
        session.set_option("hls-playlist-reload-time", BUFFER_CONFIG["HLS_PLAYLIST_RELOAD_TIME"])
        session.set_option("hls-segment-stream-data", True)

        if BUFFER_CONFIG["PREFETCH_SEGMENTS"]:
            try:
                if hasattr(stream, 'fetch_playlist'):
                    stream.fetch_playlist()
                    LOGGER.debug("HLS playlist prefetched")
                if hasattr(stream, 'reader') and hasattr(stream.reader, 'prefetch'):
                    stream.reader.prefetch(BUFFER_CONFIG["PREFETCH_COUNT"])
                    LOGGER.debug("HLS segments prefetched: %d", BUFFER_CONFIG["PREFETCH_COUNT"])
            except Exception as e:
                LOGGER.debug("HLS prefetch skipped: %s", str(e))

    elif isinstance(stream, DASHStream):
        session.set_option("dash-segment-threads", BUFFER_CONFIG["DASH_SEGMENT_THREADS"])
        session.set_option("dash-segment-attempts", BUFFER_CONFIG["DASH_SEGMENT_ATTEMPTS"])
        session.set_option("dash-segment-timeout", BUFFER_CONFIG["DASH_SEGMENT_TIMEOUT"])

        if BUFFER_CONFIG["PREFETCH_SEGMENTS"]:
            try:
                if hasattr(stream, 'fetch_manifest'):
                    stream.fetch_manifest()
                    LOGGER.debug("DASH manifest prefetched")
            except Exception as e:
                LOGGER.debug("DASH prefetch skipped: %s", str(e))

    elif isinstance(stream, HTTPStream):
        session.set_option("http-timeout", BUFFER_CONFIG["HTTP_TIMEOUT"])
        session.set_option("stream-timeout", BUFFER_CONFIG["STREAM_TIMEOUT"])


def parse_streams_parallel(streamlink, stream_objects):
    """Parse multiple streams in parallel for faster startup"""
    if not BUFFER_CONFIG["ENABLE_PARALLEL_PARSING"]:
        return None

    streams = {}

    def parse_single(stream_type, url):
        try:
            if stream_type == "hls":
                result = HLSStream.parse_variant_playlist(streamlink, url)
                if result:
                    for name, stream in result.items():
                        apply_universal_stream_optimizations(stream, streamlink)
                    return result
            elif stream_type == "dash":
                result = DASHStream.parse_manifest(streamlink, url)
                if result:
                    for name, stream in result.items():
                        apply_universal_stream_optimizations(stream, streamlink)
                    return result
        except Exception as e:
            LOGGER.debug(f"Parallel parse failed for {stream_type}: {e}")
        return None

    futures = []
    with ThreadPoolExecutor(max_workers=2) as executor:
        for stream_type, url in stream_objects:
            if stream_type in ("hls", "dash"):
                future = executor.submit(parse_single, stream_type, url)
                futures.append(future)

        for future in futures:
            result = future.result(timeout=10)
            if result:
                streams.update(result)

    return streams if streams else None


class Streamlink2(Streamlink):
    _loaded_plugins = None

    def load_builtin_plugins(self):
        if self.__class__._loaded_plugins is not None:
            self._update_loaded_plugins()
        else:
            self.load_plugins(plugins.__path__[0])
            if os.path.isdir(PLUGINS_DIR):
                self.load_ext_plugins([PLUGINS_DIR])
            self.__class__._loaded_plugins = self.plugins.copy()

    def _update_loaded_plugins(self):
        self.plugins = self.__class__._loaded_plugins.copy()
        for plugin in self.plugins:
            plugin.session = self

    def load_ext_plugins(self, dirs):
        dirs = [os.path.expanduser(d) for d in dirs]
        for directory in dirs:
            if os.path.isdir(directory):
                self.load_plugins(directory)
            else:
                LOGGER.warning("Plugin path {0} does not exist or is not a directory!".format(directory))


